# true: plan, generate, review, and validate without changing the site or publishing
# false: update the site, push, verify deployment, and publish to Instagram
DRY_RUN=true

# Override only when the GitHub Pages URL cannot be inferred from git origin.
# Example: https://damyo-zip.github.io/damyo-prompts/
PUBLIC_SITE_URL=

# Instagram API with Instagram Login (professional account required).
# Required: instagram_business_basic, instagram_business_content_publish,
# instagram_business_manage_insights
# Meta Graph API version current when this MVP was built. Re-check before upgrading.
META_API_VERSION=v25.0
META_GRAPH_BASE_URL=https://graph.instagram.com
# Account-specific credentials. Never reuse one account's values for another.
KONGI_INSTAGRAM_USER_ID=
KONGI_INSTAGRAM_ACCESS_TOKEN=
HAMNIMI_INSTAGRAM_USER_ID=
HAMNIMI_INSTAGRAM_ACCESS_TOKEN=

# Backward-compatible Kongi fallback. Existing installations may keep these
# until they migrate to the KONGI_* names. They are never used for Hamnimi.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Save a non-checkpoint latest snapshot only after this many hours.
INSIGHTS_LATEST_MIN_HOURS=12

# Bounded deployment verification (6 attempts * 10 seconds = at most 60 seconds)
DEPLOY_VERIFY_ATTEMPTS=6
DEPLOY_VERIFY_INTERVAL_MS=10000

